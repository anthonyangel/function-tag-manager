package filters

// NewGCPResourceFilter returns a map of resources that support labels.
// These values were generated by querying the provider CRDs for spec.forProvider.{{.Field}} support.
func NewGCPResourceFilter() ProviderFilter {
    return NewProviderFilter("{{.Field}}", map[string]bool{
    {{- range .Resources }}
        "{{.GroupKind}}": {{.Enabled}},
    {{- end }}
    })
}
